{
  "name": "product-comparison-desktop",
  "version": "26.11.12",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist:win": "node ../scripts/package-release.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "adm-zip": "0.6.1",
    "electron-updater": "6.8.11",
    "playwright-core": "1.62.1",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.productcomparison.desktop",
    "productName": "找商品",
    "artifactName": "ProductComparison-${version}-${arch}.${ext}",
    "electronVersion": "45.0.0",
    "electronDist": "node_modules/electron/dist",
    "buildVersion": "26.11.12.1",
    "directories": {
      "app": ".build-app",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "review.js",
      "review-ui.js",
      "review.css",
      "vision-protocol.js",
      "image-policy.js",
      "vision-queue.js"
    ],
    "asarUnpack": [
      "desktop/node_modules/@img/sharp-win32-x64/**/*",
      "desktop/node_modules/@img/sharp-libvips-win32-x64/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ProductComparison",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "include": "installer/upgrade.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://wsfile.cn/productC/updates/",
        "channel": "latest"
      }
    ],
    "detectUpdateChannel": false,
    "releaseInfo": {
      "releaseName": "26.11.12-v1",
      "releaseNotes": "新增商品流程详情：从表格商品行查看主图、六阶段进度和等待原因，返回表格定位原商品；顶部固定关闭及当前步骤、供应商图片、平台状态、供货资料、处理记录导航。供应商候选铺满宽度并支持前后翻组，保留未保存备注。处理和等待状态及时回写对应表行。青创网同次搜图等待延长至45秒，增加原生回调缺失时的同次响应读取，取消清理等待，不重复提交不确定请求。保留高相似比价和供应商页面资料优先回填。"
    }
  }
}
