{
  "name": "product-comparison-desktop",
  "version": "26.11.16",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist:win": "node ../scripts/package-release.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "adm-zip": "0.6.1",
    "electron-updater": "6.8.11",
    "playwright-core": "1.62.1",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.productcomparison.desktop",
    "productName": "找商品",
    "artifactName": "ProductComparison-${version}-${arch}.${ext}",
    "electronVersion": "45.0.0",
    "electronDist": "node_modules/electron/dist",
    "buildVersion": "26.11.16.2",
    "directories": {
      "app": ".build-app",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "review.js",
      "taobao-sales.js",
      "review-ui.js",
      "review.css",
      "vision-protocol.js",
      "image-policy.js",
      "vision-queue.js"
    ],
    "asarUnpack": [
      "desktop/node_modules/@img/sharp-win32-x64/**/*",
      "desktop/node_modules/@img/sharp-libvips-win32-x64/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ProductComparison",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "include": "installer/upgrade.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://wsfile.cn/productC/updates/",
        "channel": "latest"
      }
    ],
    "detectUpdateChannel": false,
    "releaseInfo": {
      "releaseName": "26.11.16-v2",
      "releaseNotes": "商品资料完整后跳过草稿，直接保存到正式互拓待审核，最终审核上架仍在互拓完成。网商园真实店名与档口位置分开提取；从互拓完整供应商目录自动匹配店名、缩写和仓库，旧任务也可恢复名称对应关系。模型统一填写类别、字典和动态属性，自动补齐可修正项，软件可查看候选及依据。新增前保存提交检查点，超时或重启后只回查原商品，防止重复创建。正式互拓接口授权自动刷新，业务401与桌面登录状态分开处理。"
    }
  }
}
